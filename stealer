-- FRUIT BUTTONS
local fruitButtons = {}

local function refreshFruits(filter)
	for _, b in ipairs(fruitButtons) do b:Destroy() end
	fruitButtons = {}

	for _, fruit in ipairs(FruitList) do
		if filter == "" or fruit:lower():find(filter:lower()) then
			local b = Instance.new("TextButton", fruitScroll)
			b.Size = UDim2.new(1,-20,0,30)
			b.Text = fruit
			b.Font = Enum.Font.GothamBold
			b.TextScaled = true
			b.BackgroundColor3 = Color3.fromRGB(55,55,55)
			b.TextColor3 = Color3.new(1,1,1)
			b.ZIndex = 12

			b.MouseButton1Click:Connect(function()
				selectedFruit = fruit
				selectFruit.Text = "Fruit: "..fruit

				if currentMode == "add" then
					sendChat(".add "..fruit)
				elseif currentMode == "clear" then
					sendChat(".clear "..fruit)
				end
			end)

			table.insert(fruitButtons, b)
		end
	end
end

refreshFruits("")

search:GetPropertyChangedSignal("Text"):Connect(function()
	refreshFruits(search.Text)
end)

